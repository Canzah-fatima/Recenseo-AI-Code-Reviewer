{
  "name": "recenseo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Recenseo — AI-powered code review. Structured diagnostics, complexity analysis, and one-click optimized rewrites powered by Gemini.",
  "scripts": {
